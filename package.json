{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:sanity": "playwright test --grep @sanity",
    "test:regression": "playwright test --grep @regression",
    "test:playground-api": "playwright test --project=api-playground --project=api-playground-stateful",
    "report": "playwright show-report",
    "eval": "tsx evals/run.ts",
    "report:summarize": "tsx scripts/summarize-playwright.ts",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx scripts/dev-api.ts"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "tsx": "^4.23.15",
    "typescript": "latest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0"
  }
}
