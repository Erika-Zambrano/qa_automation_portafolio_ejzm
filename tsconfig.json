{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist"
  },
  "include": [
    "api/**/*",
    "tests/**/*",
    "pages/**/*",
    "utils/**/*",
    "evals/**/*",
    "scripts/**/*"
  ]
}
